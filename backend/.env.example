# ---------------------------------------------------------------------------
# Barbearia SaaS — variáveis de ambiente do backend
# Copie para .env e preencha. NUNCA versione o arquivo .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Banco de dados PostgreSQL
DATABASE_URL="postgresql://barbearia:barbearia@localhost:5432/barbearia?schema=public"

# Segurança — gere com: openssl rand -hex 32
JWT_SECRET="troque-por-uma-chave-aleatoria-de-no-minimo-32-caracteres"
JWT_REFRESH_SECRET="troque-por-outra-chave-aleatoria-diferente-da-anterior"
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
# Lista separada por vírgula. Em produção, informe os domínios reais.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Mercado Pago
# Sem MERCADOPAGO_ACCESS_TOKEN a API usa um provedor SIMULADO,
# permitindo testar todo o fluxo de PIX/webhook sem credenciais reais.
# Credenciais em: https://www.mercadopago.com.br/developers/panel/app
# ---------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_API_URL=https://api.mercadopago.com

# Regras de negócio
PIX_EXPIRATION_MINUTES=30
SUBSCRIPTION_GRACE_DAYS=5

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Conta administrativa criada pelo seed
ADMIN_EMAIL=admin@barbearia.com
ADMIN_PASSWORD=Admin@12345

LOG_LEVEL=info
SWAGGER_ENABLED=true
